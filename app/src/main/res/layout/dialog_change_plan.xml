<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_6x"
    app:cardCornerRadius="@dimen/margin_1x"
    app:cardElevation="@dimen/margin_4x"
    app:cardUseCompatPadding="true"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_3x"
        android:paddingTop="@dimen/margin_3x"
        android:paddingBottom="@dimen/margin_3x"
        android:paddingEnd="@dimen/margin_2x"
        >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lbl_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Normal_Black"
        tools:text = "Super Saver Package"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

        <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lbl_band_width"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Small_Black"
        android:text="@string/lbl_bandwidth"
            android:drawableStart="@drawable/ic_plan_speed"
            android:drawablePadding="@dimen/margin_1x_plus2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cv_bandwidth"
            app:layout_constraintBottom_toBottomOf="@id/cv_bandwidth"
        />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_bandwidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/margin_1x"
            android:layout_marginTop="@dimen/margin_3x"
            app:cardElevation="@dimen/margin_1x"
            android:layout_marginEnd="@dimen/margin_1x"
            app:layout_constraintTop_toBottomOf="@id/lbl_dialog_title"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_bandwidth"
                style="@style/dialogSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:background="@drawable/bg_spinner"
                android:minHeight="@dimen/size_30"
                android:paddingStart="@dimen/margin_1x"
                android:paddingEnd="@dimen/size_30"
                />

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/vw_bandwidth"
            android:layout_width="@dimen/margin_half"
            android:layout_height="0dp"
            android:background="@color/colorGray"
            app:layout_constraintTop_toTopOf="@id/cv_bandwidth"
            app:layout_constraintBottom_toBottomOf="@id/cv_bandwidth"
            app:layout_constraintEnd_toEndOf="@id/cv_bandwidth"
            android:layout_marginEnd="@dimen/size_30"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/lbl_pay_per"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Small_Black"
            android:text="@string/lbl_pay_per"
            android:drawableStart="@drawable/ic_plan_date"
            android:drawablePadding="@dimen/margin_2x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cv_pay_per"
            app:layout_constraintBottom_toBottomOf="@id/cv_pay_per"
            />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_pay_per"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/margin_1x"
            android:layout_marginTop="@dimen/margin_3x"
            app:cardElevation="@dimen/margin_1x"
            android:layout_marginEnd="@dimen/margin_1x"
            app:layout_constraintTop_toBottomOf="@id/cv_bandwidth"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_pay_per"
                style="@style/dialogSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:background="@drawable/bg_spinner"
                android:minHeight="@dimen/size_30"
                android:paddingStart="@dimen/margin_1x"
                android:paddingEnd="@dimen/size_30"
                />

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/vw_pay_per"
            android:layout_width="@dimen/margin_half"
            android:layout_height="0dp"
            android:background="@color/colorGray"
            app:layout_constraintTop_toTopOf="@id/cv_pay_per"
            app:layout_constraintBottom_toBottomOf="@id/cv_pay_per"
            app:layout_constraintEnd_toEndOf="@id/cv_pay_per"
            android:layout_marginEnd="@dimen/size_30"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/lbl_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Small_Black"
            android:text="@string/lbl_amount"
            android:drawableStart="@drawable/ic_plan_price"
            android:drawablePadding="@dimen/margin_2x_2plus"
            android:layout_marginStart="@dimen/margin_1x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_amount"
            app:layout_constraintBottom_toBottomOf="@id/tv_amount"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_35"
            style="@style/CustomFont_Normal_Gray"
            tools:text = "30,000 MMK"
            android:gravity="center|start"
            android:minWidth="120dp"
            android:paddingStart="@dimen/margin_2x"
            android:paddingEnd="@dimen/margin_2x"
            android:layout_marginTop="@dimen/margin_3x"
            android:layout_marginEnd="@dimen/margin_1x"
            android:background="@drawable/bg_text_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_pay_per"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/lbl_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Small_Black"
            android:text="@string/dialog_change_plan_desc"
            android:layout_marginTop="@dimen/margin_4x"
            android:layout_marginStart="@dimen/margin_2x"
            android:layout_marginEnd="@dimen/margin_3x"
            android:textColor="@color/colorSecondary"
            app:layout_constraintStart_toEndOf="@id/iv_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_amount"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_error_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/lbl_desc"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Normal_Black"
            android:text="@string/str_cancel"
            android:textColor="@color/colorSecondary"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:layout_marginTop="@dimen/size_30"
            android:layout_marginEnd="@dimen/margin_1x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lbl_desc"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_dialog_change_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Normal_Black"
            android:text="@string/str_change_plan"
            android:textColor="@color/colorPrimary"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:layout_marginEnd="@dimen/margin_4x"
            app:layout_constraintTop_toTopOf="@id/tv_dialog_cancel"
            app:layout_constraintEnd_toStartOf="@id/tv_dialog_cancel"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>