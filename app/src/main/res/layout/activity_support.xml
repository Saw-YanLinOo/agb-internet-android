<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@id/lbl_phone"-->
<!--                    />-->

<!--                <androidx.appcompat.widget.AppCompatTextView-->
<!--                    android:id="@+id/tv_phone2"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    style="@style/CustomFont_Small_Black"-->
<!--                    android:text="(+95)9 9788343343"-->
<!--                    android:background="?attr/selectableItemBackground"-->
<!--                    android:textColor="@color/colorBlack_1x"-->
<!--                    android:layout_marginTop="@dimen/margin_1x"-->
<!--                    android:layout_marginStart="@dimen/margin_3x"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@id/tv_phone1"-->
<!--                    />-->

                <View
                    android:id="@+id/vw_phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_support_phone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Normal_Black"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:drawableStart="@drawable/ic_support_home"
                    android:text="@string/lbl_address"
                    android:gravity="center_vertical"
                    android:drawablePadding="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_3x"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_phone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Black"
                    tools:text="@string/sample_box"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:textIsSelectable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_address"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_loading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

                <include
                    layout="@layout/view_shimmer_support"/>
            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>