<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_1x_plus2"
    android:layout_marginEnd="@dimen/margin_1x_plus2">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_item_category"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_25"
        android:layout_marginTop="@dimen/margin_3x"
        android:foregroundGravity="center"
        android:src="@drawable/ic_plans"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_category"
        style="@style/CustomFont_Small_Black"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/margin_2x"
        android:layout_marginBottom="@dimen/margin_2x"
        android:gravity="top|center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_item_category"
        tools:text="Hook" />


</androidx.constraintlayout.widget.ConstraintLayout>