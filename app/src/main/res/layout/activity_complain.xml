<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground_1x"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <View
        android:id="@+id/vw_background1"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_bg_size"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="@dimen/margin_2x"
        android:src="@drawable/logo_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/margin_4x"
        android:paddingEnd="@dimen/margin_3x"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintBottom_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_logo" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="172dp" />

    <include
        android:id="@+id/ly_error"
        layout="@layout/layout_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vw_background1" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_3x"
                android:layout_marginEnd="@dimen/margin_3x"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/margin_1x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_6x">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_title"
                        style="@style/CustomFont_Title_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_3x"
                        android:text="@string/lbl_submit_complaint"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/vw_title"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/margin_half"
                        android:layout_marginStart="@dimen/margin_2"
                        android:layout_marginTop="@dimen/margin_3x"
                        android:layout_marginEnd="@dimen/margin_2"
                        android:background="@color/colorGray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lbl_title" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_ticket_number"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_ticket"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_ticket_number"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/vw_title" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_ticket_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:background="@drawable/bg_text_profile"
                        android:cursorVisible="false"
                        android:drawablePadding="@dimen/margin_2x"
                        android:paddingStart="@dimen/margin_3x"
                        android:paddingTop="@dimen/margin_2x"
                        android:paddingBottom="@dimen/margin_2x"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_ticket_number"
                        tools:text="@string/lbl_ticket_number" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_ticket_status"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_status"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_ticket_status"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_ticket_number" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_ticket_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:background="@drawable/bg_text_profile"
                        android:cursorVisible="false"
                        android:drawablePadding="@dimen/margin_2x"
                        android:paddingStart="@dimen/margin_3x"
                        android:paddingTop="@dimen/margin_2x"
                        android:paddingBottom="@dimen/margin_2x"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_ticket_status"
                        tools:text="@string/lbl_ticket_status" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_active_plan"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_active_plan"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_active_plan"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_ticket_status" />


                    <RelativeLayout
                        android:id="@+id/ly_active_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:layout_marginBottom="@dimen/margin_5x"
                        android:background="@drawable/bg_text_profile"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_active_plan">

                        <!--                    <androidx.appcompat.widget.AppCompatSpinner-->
                        <!--                     -->
                        <!--                        android:layout_width="match_parent"-->
                        <!--                        android:layout_height="40dp"-->
                        <!--                        android:entries="@array/arrayPlan"-->
                        <!--                       -->
                        <!--                        android:paddingStart="@dimen/margin_1x"-->
                        <!--                        android:paddingEnd="@dimen/margin_1x"-->
                        <!--                        android:textColor="@color/colorBlack" />-->

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spnActivePlan"
                            style="@style/dialogSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minWidth="120dp"
                            android:minHeight="@dimen/size_30"
                            android:paddingStart="@dimen/margin_1x"
                            android:paddingEnd="@dimen/size_30" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_category"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_category"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_active_category"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ly_active_plan" />


                    <RelativeLayout
                        android:id="@+id/ly_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:layout_marginBottom="@dimen/margin_5x"
                        android:background="@drawable/bg_text_profile"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_category">


                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spnCategory"
                            style="@style/dialogSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minWidth="120dp"
                            android:minHeight="@dimen/size_30"
                            android:paddingStart="@dimen/margin_1x"
                            android:paddingEnd="@dimen/size_30" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_message"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_message"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_active_message"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ly_category" />


                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:background="@drawable/bg_text_profile"
                        android:gravity="top"
                        android:hint="@string/app_name"
                        android:imeOptions="actionNext"
                        android:lines="4"
                        android:paddingStart="@dimen/margin_2x"
                        android:paddingTop="@dimen/margin_1x"
                        android:scrollbars="none"
                        android:textColor="@color/colorBlack"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="normal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_message" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_reply"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_reply"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_reply_call_center"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_message" />


                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_reply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_2x"
                        android:layout_marginTop="@dimen/margin_1x"
                        android:background="@drawable/bg_text_profile"
                        android:focusable="true"
                        android:gravity="top"
                        android:hint="@string/app_name"
                        android:imeOptions="actionNext"
                        android:inputType="textMultiLine|textCapSentences"
                        android:isScrollContainer="true"
                        android:maxLines="4"
                        android:minLines="4"
                        android:paddingStart="@dimen/margin_2x"
                        android:paddingTop="@dimen/margin_1x"
                        android:scrollbars="vertical"
                        android:textColor="@color/colorBlack"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="normal"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_reply" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lbl_image"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_3x"
                        android:layout_marginTop="@dimen/margin_2x"
                        android:drawableStart="@drawable/ic_image_upload"
                        android:drawablePadding="@dimen/margin_2x_2plus"
                        android:text="@string/lbl_image_upload"
                        android:textColor="@color/colorBlack_1x"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_reply" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraint_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_3x"
                        android:background="@drawable/bg_round_dot"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lbl_image">


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginStart="@dimen/margin_2x"
                            android:layout_marginEnd="@dimen/margin_2x"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="@+id/constraint_upload"
                            app:layout_constraintEnd_toEndOf="@+id/constraint_upload"
                            app:layout_constraintStart_toStartOf="@+id/constraint_upload"
                            app:layout_constraintTop_toTopOf="@+id/constraint_upload" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgRemove"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_1x"
                            android:elevation="@dimen/margin_1x"
                            android:padding="@dimen/margin_1x"
                            android:src="@drawable/ic_cancel_circle"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:visibility="visible" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/lblUploadPhoto"
                            style="@style/CustomFont_Normal_Black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_2x"
                            android:drawableTop="@drawable/ic_upload"
                            android:drawablePadding="@dimen/margin_2x_2plus"
                            android:text="@string/lbl_upload_photo_here"
                            android:textAlignment="center"
                            android:textColor="@color/colorGray"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <LinearLayout
                            android:id="@+id/ly_photo_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblUploadPhoto">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenGallery"
                                style="@style/Button_font_theme"
                                android:layout_width="0dip"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_3x"
                                android:layout_marginBottom="@dimen/margin_4x"
                                android:layout_weight="1"
                                android:text="@string/lbl_open_gallery"
                                android:textAllCaps="false"
                                android:textSize="@dimen/text_normal"
                                android:textStyle="bold"
                                app:backgroundTint="@color/colorPrimary"
                                app:cornerRadius="@dimen/margin_1x"
                                app:icon="@drawable/ic_gallery"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenCamera"
                                style="@style/Button_font_theme"
                                android:layout_width="0dip"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_2x"
                                android:layout_marginTop="@dimen/margin_3x"
                                android:layout_marginBottom="@dimen/margin_4x"
                                android:layout_weight="1"
                                android:text="@string/lbl_open_camera"
                                android:textAllCaps="false"
                                android:textSize="@dimen/text_normal"
                                android:textStyle="bold"
                                app:backgroundTint="@color/colorPrimary"
                                app:cornerRadius="@dimen/margin_1x"
                                app:icon="@drawable/ic_camera"
                                app:iconGravity="textStart" />


                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_dialog_cancel"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_30"
                        android:layout_marginEnd="@dimen/margin_6x"
                        android:background="?attr/selectableItemBackground"
                        android:letterSpacing="0.2"
                        android:text="@string/submit_complain_cancel"
                        android:textColor="@color/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/constraint_upload" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_submit"
                        style="@style/CustomFont_Normal_Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_6x"
                        android:background="?attr/selectableItemBackground"
                        android:letterSpacing="0.2"
                        android:text="@string/submit_complaint"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/tv_dialog_cancel"
                        app:layout_constraintTop_toTopOf="@id/tv_dialog_cancel" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_loading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <include layout="@layout/view_shimmer_complain" />

            </com.facebook.shimmer.ShimmerFrameLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>