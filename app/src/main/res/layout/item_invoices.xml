<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_plan_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Normal_Black"
        tools:text = "SS-0001"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/ic_filter_invoice"
        android:textColor="@color/colorBlack_1x"
        android:drawablePadding="@dimen/margin_2x"
        android:layout_marginTop="@dimen/margin_2x"
        android:layout_marginStart="@dimen/margin_3x"
        android:layout_marginEnd="@dimen/margin_3x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_unpaid"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_plan_invoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Normal_Black"
        tools:text = "SS-0001"
        android:gravity="center_vertical"
        android:textColor="@color/colorBlack_1x"
        android:drawableStart="@drawable/ic_plan_invoice"
        android:drawablePadding="@dimen/margin_2x_2plus"
        android:layout_marginTop="@dimen/margin_2x"
        android:layout_marginStart="@dimen/margin_3x_2plus"
        android:layout_marginEnd="@dimen/margin_3x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_plan_no"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_plan_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Small_Black"
        tools:text = "SS-0001"
        android:gravity="center_vertical"
        android:textColor="@color/colorBlack_1x"
        android:drawableStart="@drawable/ic_plan_package"
        android:drawablePadding="@dimen/margin_3x_2plus"
        android:layout_marginTop="@dimen/margin_2x"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_plan_invoice"
        app:layout_constraintEnd_toEndOf="@id/tv_plan_invoice"
        app:layout_constraintTop_toBottomOf="@id/tv_plan_invoice"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_plan_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Normal_Black"
        tools:text = "SS-0001"
        android:gravity="center_vertical"
        android:textColor="@color/colorBlack_1x"
        android:drawableStart="@drawable/ic_plan_price"
        android:drawablePadding="@dimen/margin_3x"
        android:layout_marginTop="@dimen/margin_2x"
        android:layout_marginStart="@dimen/margin_1x"
        app:layout_constraintStart_toStartOf="@id/tv_plan_invoice"
        app:layout_constraintEnd_toEndOf="@id/tv_plan_invoice"
        app:layout_constraintTop_toBottomOf="@id/tv_plan_invoice"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_plan_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Normal_Black"
        tools:text = "SS-0001"
        android:gravity="center_vertical"
        android:textColor="@color/colorBlack_1x"
        android:drawableStart="@drawable/ic_filter_date"
        android:drawablePadding="@dimen/margin_2x_2plus"
        android:layout_marginTop="@dimen/margin_2x"
        app:layout_constraintStart_toStartOf="@id/tv_plan_invoice"
        app:layout_constraintEnd_toEndOf="@id/tv_plan_invoice"
        app:layout_constraintTop_toBottomOf="@id/tv_plan_price"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_unpaid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Small_Black"
        android:gravity="center_vertical|center_horizontal"
        android:textColor="@color/colorWhite"
        android:layout_marginEnd="@dimen/margin_3x"
        android:paddingStart="@dimen/margin_2x"
        android:paddingEnd="@dimen/margin_2x"
        android:background="@drawable/bg_unpaid"
        app:layout_constraintTop_toTopOf="@id/tv_plan_no"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_paid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Small_Black"
        android:gravity="center_vertical|center_horizontal"
        android:textColor="@color/colorWhite"
        android:layout_marginEnd="@dimen/margin_3x"
        android:paddingStart="@dimen/margin_2x"
        android:paddingEnd="@dimen/margin_2x"
        android:background="@drawable/bg_paid"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tv_plan_no"
        app:layout_constraintEnd_toEndOf="parent"
        />
    
    <View
        android:id="@+id/vw_change_plan"
        android:layout_width="0dp"
        android:layout_height="@dimen/margin_half"
        android:background="@color/colorGray"
        android:layout_marginTop="@dimen/margin_2x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_plan_date"
        />

</androidx.constraintlayout.widget.ConstraintLayout>