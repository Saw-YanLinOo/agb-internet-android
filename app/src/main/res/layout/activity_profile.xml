<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/colorBackground_1x"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <View
            android:id="@+id/vw_background1"
            android:layout_width="0dp"
            android:layout_height="@dimen/header_bg_size"
            android:background="@color/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:src="@drawable/logo_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_back_arrow"
            android:paddingStart="@dimen/margin_4x"
            android:paddingEnd="@dimen/margin_3x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_logo"
            app:layout_constraintBottom_toBottomOf="@id/iv_logo"
            />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="172dp" />

    <include
        android:id="@+id/ly_error"
        layout="@layout/layout_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vw_background1"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        >

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_3x"
            android:layout_marginTop="@dimen/margin_3x"
            android:layout_marginEnd="@dimen/margin_3x"
            app:cardCornerRadius="@dimen/margin_1x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_title"
                    style="@style/CustomFont_Title_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_3x"
                    android:text="@string/title_profile"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/vw_title"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_user_name"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_user_name"
                    android:drawablePadding="@dimen/margin_2x_2plus"
                    android:text="@string/lbl_username"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_user_name"
                    app:layout_constraintBottom_toBottomOf="@id/tv_user_name"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_user_name"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    tools:text = "REC-0001"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_title"
                    app:layout_constraintStart_toEndOf="@id/lbl_user_name"
                    />

                <View
                    android:id="@+id/vw_user_name"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_user_name" />

                <View
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="@dimen/margin_0"
                    android:id="@+id/vw_ration"
                    android:layout_marginStart="@dimen/margin_3x"
                    app:layout_constraintStart_toEndOf="@id/lbl_alt_phone"
                    app:layout_constraintTop_toBottomOf="@id/vw_user_phone"
                    app:layout_constraintBottom_toTopOf="@id/vw_viber_no"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_phone"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_user_phone"
                    android:drawablePadding="@dimen/margin_2x"
                    android:text="@string/lbl_phone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_phone"
                    app:layout_constraintBottom_toBottomOf="@id/tv_phone"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tv_phone"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_25"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:inputType="phone"
                    android:background="@drawable/bg_et_search"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:paddingTop="@dimen/margin_1x"
                    android:paddingBottom="@dimen/margin_1x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_user_name"
                    app:layout_constraintStart_toEndOf="@id/vw_ration"
                    />

                <View
                    android:id="@+id/vw_user_phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_phone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_alt_phone"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_user_phone"
                    android:drawablePadding="@dimen/margin_2x"
                    android:text="@string/lbl_alternative_phone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_alt_phone"
                    app:layout_constraintBottom_toBottomOf="@id/tv_alt_phone"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tv_alt_phone"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_25"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:inputType="phone"
                    android:background="@drawable/bg_et_search"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:paddingTop="@dimen/margin_1x"
                    android:paddingBottom="@dimen/margin_1x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_user_phone"
                    app:layout_constraintStart_toEndOf="@id/vw_ration"
                    />

                <View
                    android:id="@+id/vw_alt_phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_alt_phone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_viber_no"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_2x_2plus"
                    android:drawableStart="@drawable/ic_viber"
                    android:drawablePadding="@dimen/margin_1x_plus2"
                    android:text="@string/lbl_viber_no"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_viber_no"
                    app:layout_constraintBottom_toBottomOf="@id/tv_viber_no"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tv_viber_no"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_25"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:inputType="phone"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:background="@drawable/bg_et_search"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:paddingTop="@dimen/margin_1x"
                    android:paddingBottom="@dimen/margin_1x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_alt_phone"
                    app:layout_constraintStart_toEndOf="@id/vw_ration"
                    />

                <View
                    android:id="@+id/vw_viber_no"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_viber_no" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_email"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_2x_2plus"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="@dimen/margin_1x_plus2"
                    android:text="@string/lbl_email"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_email"
                    app:layout_constraintBottom_toBottomOf="@id/tv_email"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tv_email"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_25"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_et_search"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:paddingTop="@dimen/margin_1x"
                    android:paddingBottom="@dimen/margin_1x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_viber_no"
                    app:layout_constraintStart_toEndOf="@id/vw_ration"
                    />

                <View
                    android:id="@+id/vw_email"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_email" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_activation_date"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_2x_2plus"
                    android:drawableStart="@drawable/ic_date"
                    android:drawablePadding="@dimen/margin_1x_plus2"
                    android:text="@string/lbl_activation_date"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_activation_date"
                    app:layout_constraintBottom_toBottomOf="@id/tv_activation_date"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activation_date"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_email"
                    app:layout_constraintStart_toEndOf="@id/lbl_activation_date"
                    />

                <View
                    android:id="@+id/vw_activation_date"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_activation_date" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_membership_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_2x_2plus"
                    android:drawableStart="@drawable/ic_membership_id"
                    android:drawablePadding="@dimen/margin_1x_plus2"
                    android:text="@string/lbl_membership_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_membership_id"
                    app:layout_constraintBottom_toBottomOf="@id/tv_membership_id"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_membership_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_activation_date"
                    app:layout_constraintStart_toEndOf="@id/lbl_membership_id"
                    />

                <View
                    android:id="@+id/vw_membership_id"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_membership_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_balance"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_4x"
                    android:drawableStart="@drawable/ic_profile_balance"
                    android:drawablePadding="@dimen/margin_3x"
                    android:text="@string/lbl_balance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_balance"
                    app:layout_constraintBottom_toBottomOf="@id/tv_balance"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_balance"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    tools:text = "2021090000001"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_membership_id"
                    app:layout_constraintStart_toEndOf="@id/lbl_balance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_version_no"
            style="@style/CustomFont_Normal_Black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_2x"
            android:layout_marginTop="@dimen/margin_2x"
            android:layout_marginEnd="@dimen/margin_3x"
            android:layout_marginBottom="@dimen/margin_3x"
            android:gravity="center|end"
            android:textColor="@color/colorBlack_1x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_profile"
            tools:text="Version:1.1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/cv_profile"
            app:layout_constraintStart_toStartOf="@id/cv_profile"
            app:layout_constraintTop_toBottomOf="@id/tv_version_no">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Button_font_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_4x"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginEnd="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_2x"
                android:minWidth="@dimen/size_105"
                android:padding="@dimen/margin_2x"
                android:singleLine="true"
                android:text="@string/str_save"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/margin_1x"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btn_cancel"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Button_font_theme_unelevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_4x"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginEnd="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_2x"
                android:layout_weight="1"
                android:visibility="gone"
                android:minWidth="@dimen/size_105"
                android:padding="@dimen/margin_2x"
                android:singleLine="true"
                android:text="@string/str_cancel"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                app:backgroundTint="@color/colorWhite"
                app:cornerRadius="@dimen/margin_1x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_save"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Button_font_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_4x"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginEnd="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_2x"
                android:minWidth="@dimen/size_105"
                android:padding="@dimen/margin_2x"
                android:singleLine="true"
                android:text="@string/str_edit"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/margin_1x"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/margin_1x"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_loading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

