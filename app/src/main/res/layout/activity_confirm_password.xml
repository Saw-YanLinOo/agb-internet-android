<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorPrimary">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.27"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.37"
        />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize"
        android:src="@drawable/ic_back_arrow"
        android:paddingStart="@dimen/margin_3x"
        android:paddingEnd="@dimen/margin_3x"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_login_background"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_lunch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline2"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lbl_invoices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CustomFont_Title_Black"
        android:textStyle="bold"
        android:text="@string/lbl_change_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideline3"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ly_new_password"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_3x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline3"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_new_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/CustomFont_Normal_Black"
            android:inputType="textPassword"
            android:maxLines="1"
            android:hint="@string/lbl_new_password"
            android:textColorHint="@color/colorBlack"
            android:paddingEnd="@dimen/size_40"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_new_password"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_baseline_visibility_off_24"
        android:paddingTop="@dimen/margin_1x"
        android:paddingEnd="@dimen/margin_3x"
        app:layout_constraintEnd_toEndOf="@id/ly_new_password"
        app:layout_constraintTop_toTopOf="@id/ly_new_password"
        app:layout_constraintBottom_toBottomOf="@id/ly_new_password"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ly_confirm_password"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_3x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ly_new_password"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/CustomFont_Normal_Black"
            android:inputType="textPassword"
            android:maxLines="1"
            android:hint="@string/lbl_confirm_password"
            android:textColorHint="@color/colorBlack"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_confirm_password"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_baseline_visibility_off_24"
        android:paddingTop="@dimen/margin_1x"
        android:paddingEnd="@dimen/margin_3x"
        app:layout_constraintEnd_toEndOf="@id/ly_confirm_password"
        app:layout_constraintTop_toTopOf="@id/ly_confirm_password"
        app:layout_constraintBottom_toBottomOf="@id/ly_confirm_password"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_40"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        style="@style/Button_font_theme"
        android:text="@string/str_change"
        app:backgroundTint="@color/colorPrimary"
        android:textAllCaps="false"
        android:textSize="@dimen/text_normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ly_confirm_password"
        android:layout_marginStart="@dimen/margin_3x"
        android:layout_marginEnd="@dimen/margin_3x"
        android:layout_marginTop="@dimen/size_35"
        />

</androidx.constraintlayout.widget.ConstraintLayout>