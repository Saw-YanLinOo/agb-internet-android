<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_term_condition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_3x"
            android:layout_marginTop="@dimen/margin_3x"
            android:layout_marginEnd="@dimen/margin_3x"
            app:cardCornerRadius="@dimen/margin_1x"
            android:layout_marginBottom="@dimen/margin_3x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_title"
                    style="@style/CustomFont_Title_Black"
                    android:layout_width="@dimen/size_105"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_3x"
                    android:background="@color/shimmerColor"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/vw_title"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_title" />

               <androidx.appcompat.widget.AppCompatTextView
                   android:id="@+id/lbl_term_condition_title"
                   android:layout_width="@dimen/size_105"
                   android:layout_height="wrap_content"
                   style="@style/CustomFont_Normal_Black"
                   android:background="@color/shimmerColor"
                   android:layout_marginStart="@dimen/margin_1x"
                   android:layout_marginTop="@dimen/margin_3x"
                   android:visibility="gone"
                   app:layout_constraintStart_toStartOf="parent"
                   app:layout_constraintTop_toBottomOf="@id/vw_title"
                   />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_term_condition_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Gray"
                    android:background="@color/shimmerColor"
                    android:layout_marginStart="@dimen/margin_1x"
                    android:layout_marginEnd="@dimen/margin_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_term_condition_title"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_term_condition_desc1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Gray"
                    android:background="@color/shimmerColor"
                    android:layout_marginStart="@dimen/margin_1x"
                    android:layout_marginEnd="@dimen/margin_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_term_condition_desc"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_term_condition_desc2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Gray"
                    android:background="@color/shimmerColor"
                    android:layout_marginStart="@dimen/margin_1x"
                    android:layout_marginEnd="@dimen/margin_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_term_condition_desc1"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_term_condition_desc3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Gray"
                    android:background="@color/shimmerColor"
                    android:layout_marginStart="@dimen/margin_1x"
                    android:layout_marginEnd="@dimen/margin_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_term_condition_desc2"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_term_condition_desc4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/CustomFont_Small_Gray"
                    android:background="@color/shimmerColor"
                    android:layout_marginStart="@dimen/margin_1x"
                    android:layout_marginEnd="@dimen/margin_1x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginBottom="@dimen/margin_2x"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_term_condition_desc3"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>