                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lbl_notification1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_noti1"
                style="@style/CustomFont_Small_Black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_1x"
                android:layout_marginBottom="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_notification1" />

            <View
