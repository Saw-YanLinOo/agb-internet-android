<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:ignore="MissingDefaultResource">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_notification"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_3x"
        android:layout_marginTop="@dimen/margin_3x"
        android:layout_marginEnd="@dimen/margin_3x"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/margin_1x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lbl_title"
                style="@style/CustomFont_Title_Black"
                android:layout_width="@dimen/size_105"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/vw_title"
                android:layout_width="0dp"
                android:layout_height="@dimen/margin_half"
                android:layout_marginStart="@dimen/margin_2"
                android:layout_marginTop="@dimen/margin_3x"
                android:layout_marginEnd="@dimen/margin_2"
                android:background="@color/colorGray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lbl_title" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lbl_mail"
                style="@style/CustomFont_Normal_Black"
                android:layout_width="@dimen/size_20"
                android:layout_height="@dimen/size_20"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vw_title" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lbl_mail_dot"
                style="@style/CustomFont_Normal_Black"
                android:layout_width="@dimen/size_105"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/margin_2x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/lbl_mail"
                app:layout_constraintStart_toEndOf="@id/lbl_mail"
                app:layout_constraintTop_toTopOf="@id/lbl_mail" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_mail"
                style="@style/CustomFont_Small_Black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_2x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
