                android:layout_width="@dimen/size_20"
                android:layout_height="@dimen/size_20"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:gravity="center_vertical"
                android:textColor="@color/colorBlack_1x"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vw_noti2" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lbl_notification2_dot"
                style="@style/CustomFont_Normal_Black"
                android:layout_width="@dimen/size_105"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/margin_2x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/lbl_notification2"
                app:layout_constraintStart_toEndOf="@id/lbl_notification2"
                app:layout_constraintTop_toTopOf="@id/lbl_notification2" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_notification2"
                style="@style/CustomFont_Small_Black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lbl_notification2" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_noti2"
                style="@style/CustomFont_Small_Black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_3x"
                android:layout_marginTop="@dimen/margin_1x"
                android:layout_marginBottom="@dimen/margin_3x"
                android:background="@color/shimmerColor"
                android:textColor="@color/colorBlack_1x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_notification2" />

