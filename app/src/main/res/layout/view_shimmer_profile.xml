<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.235"
            />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_receipt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_3x"
            android:layout_marginTop="@dimen/margin_3x"
            android:layout_marginEnd="@dimen/margin_3x"
            app:cardCornerRadius="@dimen/margin_1x"
            android:layout_marginBottom="@dimen/margin_3x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_title"
                    style="@style/CustomFont_Title_Black"
                    android:layout_width="@dimen/size_105"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_3x"
                    android:background="@color/shimmerColor"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/vw_title"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_user_name"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="@dimen/size_105"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:background="@color/shimmerColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_user_name"
                    app:layout_constraintBottom_toBottomOf="@id/tv_user_name"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_user_name"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:background="@color/shimmerColor"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_title"
                    app:layout_constraintStart_toEndOf="@id/lbl_user_name"
                    />

                <View
                    android:id="@+id/vw_user_name"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_user_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_phone"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="@dimen/size_105"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:background="@color/shimmerColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_phone"
                    app:layout_constraintBottom_toBottomOf="@id/tv_phone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_phone"
                    style="@style/CustomFont_Small_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    android:background="@color/shimmerColor"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_user_name"
                    app:layout_constraintStart_toEndOf="@id/lbl_phone"
                    />

                <View
                    android:id="@+id/vw_user_phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_phone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_balance"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="@dimen/size_105"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:background="@color/shimmerColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_balance"
                    app:layout_constraintBottom_toBottomOf="@id/tv_balance"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_balance"
                    style="@style/CustomFont_Small_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack_1x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:gravity="center|end"
                    android:background="@color/shimmerColor"
                    android:layout_marginBottom="@dimen/margin_3x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vw_user_phone"
                    app:layout_constraintStart_toEndOf="@id/lbl_balance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/ly_error"
        layout="@layout/layout_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline4"
        />

</androidx.constraintlayout.widget.ConstraintLayout>