<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground_1x"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <View
            android:id="@+id/vw_background1"
            android:layout_width="0dp"
            android:layout_height="@dimen/header_bg_size"
            android:background="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="@dimen/margin_2x"
            android:src="@drawable/logo_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:paddingStart="@dimen/margin_4x"
            android:paddingEnd="@dimen/margin_3x"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="@id/iv_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_logo" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.235" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_receipt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_3x"
            android:layout_marginTop="@dimen/margin_3x"
            android:layout_marginEnd="@dimen/margin_3x"
            app:cardCornerRadius="@dimen/margin_1x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_title"
                    style="@style/CustomFont_Title_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_3x"
                    android:text="@string/lbl_receipt"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/vw_title"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_receipt_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_receipt_record"
                    android:drawablePadding="@dimen/margin_3x"
                    android:text="@string/lbl_receipt_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_receipt_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_receipt_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_receipt_id"
                    app:layout_constraintTop_toBottomOf="@id/vw_title"
                    tools:text="REC-0001" />

                <View
                    android:id="@+id/vw_receipt_id"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_receipt_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_service_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_filter_invoice"
                    android:drawablePadding="@dimen/margin_2x"
                    android:text="@string/lbl_invoice_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_service_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_service_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_service_id"
                    app:layout_constraintTop_toBottomOf="@id/vw_receipt_id"
                    tools:text="2021090000001" />

                <View
                    android:id="@+id/vw_service_id"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_service_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_transaction_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_transaction"
                    android:drawablePadding="@dimen/margin_2x_2plus"
                    android:text="@string/lbl_transaction_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_transaction_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_transaction_id"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_transaction_id"
                    app:layout_constraintTop_toBottomOf="@id/vw_service_id"
                    tools:text="1212122211111" />

                <View
                    android:id="@+id/vw_transaction_id"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_transaction_id" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_payment_type"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:drawableStart="@drawable/ic_payment"
                    android:drawablePadding="@dimen/margin_2x_2plus"
                    android:text="@string/lbl_payment_type"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_payment_type" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_payment_type"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_payment_type"
                    app:layout_constraintTop_toBottomOf="@id/vw_transaction_id"
                    tools:text="1212122211111" />

                <View
                    android:id="@+id/vw_payment_type"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_payment_type" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_paid_date"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x_2plus"
                    android:drawableStart="@drawable/ic_filter_date"
                    android:drawablePadding="@dimen/margin_2x_2plus"
                    android:text="@string/lbl_paid_date"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_paid_date" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_paid_date"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_paid_date"
                    app:layout_constraintTop_toBottomOf="@id/vw_payment_type"
                    tools:text="1212122211111" />

                <View
                    android:id="@+id/vw_paid_date"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_half"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:background="@color/colorGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_paid_date" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lbl_amount"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4x"
                    android:layout_marginTop="@dimen/margin_2"
                    android:drawableStart="@drawable/ic_plan_price"
                    android:drawablePadding="@dimen/margin_3x_2plus"
                    android:text="@string/lbl_amount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_amount"
                    style="@style/CustomFont_Normal_Black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginBottom="@dimen/margin_3x"
                    android:gravity="center|end"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lbl_amount"
                    app:layout_constraintTop_toBottomOf="@id/vw_paid_date"
                    tools:text="1212122211111" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_download"
            style="@style/Button_font_theme"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_40"
            android:layout_marginTop="@dimen/margin_5x"
            android:text="@string/str_download"
            android:textAllCaps="false"
            android:textSize="@dimen/text_normal"
            android:textStyle="bold"
            app:cornerRadius="@dimen/margin_1x"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="@id/cv_receipt"
            app:layout_constraintStart_toStartOf="@id/cv_receipt"
            app:layout_constraintTop_toBottomOf="@id/cv_receipt" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo">

            <include layout="@layout/view_shimmer_receipt_detail" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <include
            android:id="@+id/ly_error"
            layout="@layout/layout_error"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline4" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>