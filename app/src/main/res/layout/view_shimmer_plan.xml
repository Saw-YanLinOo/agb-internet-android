<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground_1x"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_active_plan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/margin_3x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/lbl_active_plans"
            android:layout_width="@dimen/size_105"
            android:layout_height="wrap_content"
            style="@style/CustomFont_Title_Black"
            android:textStyle="bold"
            android:background="@color/shimmerColor"
            android:layout_margin="@dimen/margin_3x"
            android:layout_gravity="center"
            />

            <View
                android:id="@+id/vw_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_half"
                android:background="@color/colorGray"
                android:layout_marginStart="@dimen/margin_2"
                android:layout_marginEnd="@dimen/margin_2"
                android:layout_marginTop="@dimen/margin_2x"
                />

            <include
                layout="@layout/view_shimmer_pending_item_plan"/>

            <include
                layout="@layout/view_shimmer_pending_item_plan"/>

            <include
                layout="@layout/view_shimmer_pending_item_plan"/>




        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/ly_error"
        layout="@layout/layout_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>